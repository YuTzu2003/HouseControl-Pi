# RGB LED wiring: pins 29, 31 and 33 map to red, green and blue by default.
# Valid channel orders are any permutation of rgb, for example: brg
HOUSE_CONTROL_LED_CHANNEL_ORDER=rgb

# Set to true only for a common-anode RGB LED/driver (PWM duty is inverted).
HOUSE_CONTROL_LED_COMMON_ANODE=false

# Example for the eMeet M0 USB speaker. Uncomment when it is the target output.
# HOUSE_CONTROL_AUDIO_DEVICE=pipewire/alsa_output.usb-EMEET_eMeet_M0_000000000000000000000654d6565742020200731b6ab7643a2e3eMeet_M0-00.analog-stereo
